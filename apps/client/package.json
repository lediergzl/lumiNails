{
  "name": "@lumi/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "cap:sync": "npx cap sync android",
    "android:debug": "npm run build && npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build && npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
